# Variables para los tests E2E (Playwright).
# Valores ficticios: con Supabase "configurado" la app arranca en la pantalla
# de login y los tests entran al modo demo con el botón "Explorar en modo demo".
# Sin estas variables la app arrancaría directo en demo y ese botón no existe.
# En local, .env.local (valores reales) tiene prioridad sobre este archivo.
VITE_SUPABASE_URL=https://e2e-demo.supabase.co
VITE_SUPABASE_ANON_KEY=e2e-anon-key-ficticia
