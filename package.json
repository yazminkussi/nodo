    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "framer-motion": "^11.11.0",
    "html5-qrcode": "^2.3.8",
