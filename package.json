{
  "name": "nodo-experiencia-digital",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "NODO - Experiencia Digital para Comunidades. Prototipo PWA para clubes, centros culturales y movimientos juveniles.",
  "author": "Yazmín Laila Kussi",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
